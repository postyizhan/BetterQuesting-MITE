{
  "schemaVersion": 1,
  "id": "betterquesting",
  "version": "${version}",
  "name": "BetterQuesting",
  "description": "A server-authoritative questing system port for Minecraft 1.6.4-MITE.",
  "authors": [
    "Funwayguy",
    "postyizhan"
  ],
  "contact": {
    "sources": "https://github.com/postyizhan/BetterQuesting-MITE"
  },
  "license": "MIT",
  "icon": "assets/betterquesting/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.postyizhan.betterquesting.BetterQuestingMod"
    ],
    "registry": [
      "com.github.postyizhan.betterquesting.platform.fml.BetterQuestingRegistry"
    ]
  },
  "mixins": [
    "betterquesting.mixins.json"
  ],
  "depends": {
    "fishmodloader": ">=3.4.2",
    "minecraft": "1.6.4-mite",
    "java": ">=17",
    "rusted_iron_core": ">=1.5.0",
    "many-lib": ">=2.3.1"
  },
  "accessWidener": "betterquesting.accesswidener"
}
